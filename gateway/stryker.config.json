{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "mutate": [
    "src/task.ts",
    "src/device.ts",
    "src/parts.ts",
    "src/acl.ts",
    "src/ratelimit.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "json"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "timeoutMS": 30000,
  "concurrency": 2,
  "disableTypeChecks": "src/{task,device,parts,acl,ratelimit}.ts",
  "tsconfigFile": "tsconfig.stryker-none.json"
}
