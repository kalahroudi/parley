{
  "name": "@parley/gateway",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Parley gateway Worker (A2A transport, Durable Objects, admin API)",
  "scripts": {
    "test": "vitest run --exclude test/soak.test.ts",
    "test:oidc-coverage": "node --test --experimental-test-coverage --test-coverage-include=src/oidc.ts --test-coverage-include=src/auth.ts --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 ../tests/gateway-oidc.test.mjs",
    "test:coverage": "vitest run --exclude test/soak.test.ts --coverage",
    "test:mutation": "stryker run",
    "test:soak": "vitest run test/soak.test.ts",
    "typecheck": "tsc",
    "dev": "wrangler dev --port ${PORT:-8787}"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-istanbul": "^4.1.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.1"
  }
}
