;;
;; Parley: keep a bot away from the daemon's local socket (macOS).
;; Run the bot as:  sandbox-exec -f macos.sb <bot command> [args...]
;; The bot can still do everything else (files, network); it cannot connect to, or create, a Unix-domain socket.
;; sandbox-exec is marked deprecated by Apple but is still shipped and enforced.
(version 1)
(allow default)
(deny network-outbound (remote unix-socket))
(deny network-bind (local unix-socket))
